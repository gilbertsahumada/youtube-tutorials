# Copy to .env. Credentials are configured only here or in the process environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HTTPS base URL and model ID from your own Chat Completions provider.
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=

# Optional: legacy CLI commands (docs/scripts.md).
# The UI manages destinations, sender filters, start dates and optional labels in SQLite.
# These Gmail variables are only used by the CLI or a one-time migration.
# Optional existing label in the receiving Gmail account; blank searches by sender.
GMAIL_LABEL=
# CLI: ISO timestamp BEFORE sending the initial agreement email.
GMAIL_AFTER=
# To import a legacy CLI project into an empty UI database, opt in explicitly.
IMPORT_LEGACY_PROJECT=false
ALLOWED_SENDER=
GITHUB_REPO=
GITHUB_ISSUE_NUMBER=
# Gmail API ID, not the browser URL or RFC Message-ID. Required by CLI baseline.
GMAIL_INITIAL_MESSAGE_ID=
POLL_SECONDS=30
# CLI only. UI publication always requires its review button.
PUBLISH=false
