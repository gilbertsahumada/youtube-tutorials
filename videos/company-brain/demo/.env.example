# Copy to .env. Credentials are configured only here or in the process environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Existing label in the receiving Gmail account.
GMAIL_LABEL=
# ISO timestamp BEFORE sending the initial agreement email.
GMAIL_AFTER=
# HTTPS base URL and model ID from your own Chat Completions provider.
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=

# Optional: legacy CLI commands (docs/scripts.md).
# The UI manages destinations and sender filters per project in SQLite.
# An explicitly configured legacy project is imported once at first use.
ALLOWED_SENDER=
GITHUB_REPO=
GITHUB_ISSUE_NUMBER=
# Gmail API ID, not the browser URL or RFC Message-ID. Required by CLI baseline.
GMAIL_INITIAL_MESSAGE_ID=
POLL_SECONDS=30
# CLI only. UI publication always requires its review button.
PUBLISH=false
