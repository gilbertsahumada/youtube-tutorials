# Copia a .env. Las credenciales se configuran aquí o en el entorno del servidor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL base HTTPS, sin /chat/completions; el servidor añade esa ruta.
# Ejemplo personalizable: QwenCloud puede alojar modelos de otro proveedor, como DeepSeek.
MODEL_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
MODEL_ID=deepseek-v4.1-flash
MODEL_API_KEY=

# Configura proyectos, participantes, fechas y etiquetas opcionales en la UI.
