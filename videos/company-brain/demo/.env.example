# Copy to .env. Never commit credentials. Use a dedicated Gmail account and GitHub sandbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_LABEL=company-brain-demo
ALLOWED_SENDER=client@example.com
# Set to an ISO timestamp BEFORE sending the initial email.
GMAIL_AFTER=
# Gmail API ID printed by npm run inbox; not the browser URL or RFC Message-ID.
GMAIL_INITIAL_MESSAGE_ID=
GITHUB_REPO=your-user/company-brain-sandbox
GITHUB_ISSUE_NUMBER=1
POLL_SECONDS=30
# Use the HTTPS base URL and model ID from your own Chat Completions provider.
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=
# Only a comment is written. Start false, inspect once, then enable in the sandbox.
PUBLISH=false
