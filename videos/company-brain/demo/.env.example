# Copy to .env; scripts load it with process.loadEnvFile(). Never commit credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_LABEL=company-brain-demo
GITHUB_REPO=your-user/company-brain-sandbox
GITHUB_ISSUE_NUMBER=1
APPROVED_SENDER=client@example.com
# ISO timestamp: only emails received after this point will be processed.
GMAIL_AFTER=2026-01-01T00:00:00Z
POLL_SECONDS=30
# OpenAI-compatible Chat Completions endpoint. Provider example, not a requirement.
MODEL_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
MODEL_ID=deepseek-v4.1-flash
MODEL_API_KEY=
# Default: no writes to GitHub. Set true only in the sandbox after reviewing previews.
PUBLISH=false
