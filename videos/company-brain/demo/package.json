{
  "name": "company-brain-demo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm test && npm run test:fixture && npm run test:browser",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "node src/server.mjs",
    "test:fixture": "node src/main.mjs --fixture",
    "once": "node src/main.mjs --once",
    "watch": "node src/main.mjs --watch",
    "inbox": "node src/main.mjs --inbox",
    "baseline": "node src/main.mjs --baseline",
    "gmail:login": "node src/gmail-login.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
