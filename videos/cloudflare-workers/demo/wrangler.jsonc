{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acortador-workers-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
