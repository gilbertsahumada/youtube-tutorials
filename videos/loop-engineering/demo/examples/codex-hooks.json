{
  "description": "Impide terminar una vez si la verificación de la demo sigue fallando.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/videos/loop-engineering/demo/scripts/stop-until-verified.mjs\"",
            "timeout": 30,
            "statusMessage": "Verificando la exportación CSV"
          }
        ]
      }
    ]
  }
}
